# ============================================================
# Zendrian Warehouse — Environment Configuration
# Copy this file to .env and customise for your deployment
# ============================================================

# REQUIRED: Set a strong random secret key for production
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Database Configuration
# Default: SQLite (no additional dependencies needed)
DATABASE_URL=sqlite:////app/instance/zendrian_warehouse.db

# MySQL/MariaDB (uncomment below and comment out SQLite above)
# Requires: pip install PyMySQL
# DATABASE_URL=mysql+pymysql://warehouse_user:warehouse_pass@mariadb:3306/zendrian_warehouse

# Minimum seconds between duplicate scans (anti-bounce)
MIN_SCAN_INTERVAL=0.7

# Default admin credentials (only used on first run when DB is empty)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=change-me-on-first-login
